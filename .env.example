# Secret NAMES only. No keys or passwords go in this file.
# The zero-credential default runs a labeled scripted demo with local SQLite.
GOOGLE_CLOUD_PROJECT=ai-leadscore
GOOGLE_CLOUD_REGION=us-central1
PUBLIC_ORIGIN=http://127.0.0.1:8090
# Optional exact HTTPS origin for the public synthetic demo only.
# DEMO_ORIGIN=https://your-approved-service.run.app
DATABASE_URL=sqlite:///.data/prospectiq.db
OPENAI_MODEL=gpt-4.1-mini
# Enable real interactive OpenAI by setting the Secret Manager name below.
# OPENAI_SECRET_NAME=OPENAI_API_KEY
# ADMIN_SECRET_NAME=PROSPECTIQ_ADMIN_KEY
# Optional local fallback uses the existing gcloud account when ADC is absent.
# PROSPECTIQ_ALLOW_GCLOUD_FALLBACK=true
DEMO_AI_BUDGET=12
MAX_AI_CALLS_PER_HOUR=100
# Model-specific rates per million tokens, verified against official pricing.
# OPENAI_INPUT_USD_PER_MILLION=0.40
# OPENAI_CACHED_USD_PER_MILLION=0.10
# OPENAI_OUTPUT_USD_PER_MILLION=1.60
# OPENAI_PRICE_REFERENCE=https://developers.openai.com/api/docs/pricing (verified 2026-10-08)
ALLOW_CRM_FOLLOWUP=false
ALLOW_CLOUD_TASKS=false
DEMO_VOICE_ISOLATED=false
# Only after provisioning/approval, with runtime identity scoped to named secrets:
# CLOUD_SQL_INSTANCE=project:region:prospectiq-db
# DATABASE_USER=prospectiq
# DATABASE_NAME=prospectiq
# DATABASE_PASSWORD_SECRET=PROSPECTIQ_DB_PASSWORD
# TASK_QUEUE=prospectiq-research
# RESEARCH_WORKER_URL=https://approved-worker-url/api/internal/research
# TASK_SERVICE_ACCOUNT=approved-task-identity@project.iam.gserviceaccount.com
# GHL_COHORT_TAG=prospectiq-approved
# SECURE_COOKIES=true
# Do not set production widget IDs/phone numbers here for a public portfolio demo.
# DEMO_VOICE_BROWSER_ORIGIN=https://approved-separate-voice-origin
# VOICE_ALLOWED_PARENT_ORIGIN=https://approved-prospectiq-origin
